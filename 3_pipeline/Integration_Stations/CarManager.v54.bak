local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalogue = require(ReplicatedStorage:WaitForChild("Catalogue"))
local HttpService = game:GetService("HttpService")

local Sessions = {}

local Car = require(ReplicatedStorage:WaitForChild("Catalogue"):WaitForChild("Car"))
local Circulation = require(game:GetService("ServerScriptService"):WaitForChild("Circulation"))   -- couloirs de 2 cases, vitesses
-- v48 : QUADRILLAGE DE 15 STUDS (CASE) ; DEMI = demi-case (meme valeur que PlotManager).
local CASE = 15
local DEMI = CASE / 2

local MovePnjEvent = ReplicatedStorage:WaitForChild("MovePnjEvent")
local MoveCarEvent = ReplicatedStorage:WaitForChild("MoveCarEvent")

-- ======================================================================================================================
-- STATIONS ANIMEES (ReplicatedStorage > Stations)
--   Le serveur ne calcule aucun mouvement : il pose sur le modele 3D de la station l'attribut "CycleDebut" (heure
--   serveur du debut du service) et un ObjectValue "VoitureCycle" (la voiture cliente). Chez chaque joueur, le module
--   Stations > Client cache cette voiture, anime une copie soudee a la station, puis la re-affiche quand CycleDebut
--   revient a 0. Le serveur attend simplement la duree du cycle (CYCLE, donnees de la station) : ce sont ces donnees,
--   et jamais le client, qui font foi pour l'economie (stock consomme, paiement, XP).
-- ======================================================================================================================

local StationsDossier = ReplicatedStorage:FindFirstChild("Stations")
local Y_LOIN = 36        -- distance (studs, repere du modele) d'ou arrive / ou repart la voiture dans les animations

-- donnees d'une station (module ReplicatedStorage > Stations > Donnees > <nom du meuble>), nil si le meuble n'en a pas
local function donneesStation(nomStation)
	local dossier = StationsDossier and StationsDossier:FindFirstChild("Donnees")
	local mod = dossier and dossier:FindFirstChild(nomStation)
	if not mod then return nil end
	local ok, D = pcall(require, mod)
	return ok and type(D) == "table" and D or nil
end

-- modele 3D d'un meuble du plot (attribut FurnitureID pose par PlotManager)
local function trouverMeuble(player, furnitureID)
	local folder = workspace.Plots:FindFirstChild(player.Name .. "'s plot")
	if not folder then return nil end
	for _, objet in ipairs(folder:GetChildren()) do
		if objet:GetAttribute("FurnitureID") == furnitureID then return objet end
	end
	return nil
end

-- position de la voiture dans la voie de la station : y = position le long de la voie (repere du modele ;
-- nil = place de stationnement, -Y_LOIN = point de sortie). Le Socle de la station porte le repere du modele.
local function pointStation(meuble, D, y)
	local socle = meuble and meuble:FindFirstChild("Socle")
	if not (socle and D) then return nil end
	local parc = D.PARC or (D.SEGMENTS and D.SEGMENTS[1] and D.SEGMENTS[1].parc)
	if not parc then return nil end
	-- v49 : le modele est agrandi (ScaleTo x1,5) mais PARC est en studs du modele d'origine : on applique l'echelle
	local okS, s = pcall(function() return meuble:GetScale() end)
	if not okS or type(s) ~= "number" or s <= 0 then s = 1 end
	local pos = socle.CFrame * Vector3.new(parc[1] * s, y or parc[2] * s, parc[3] * s)
	local dir = socle.CFrame:VectorToWorldSpace(Vector3.new(0, -1, 0))     -- la voiture regarde vers -Y du modele
	return CFrame.lookAt(pos, pos + dir)
end

-- lance le cycle de la station chez les joueurs ; renvoie {meuble, D, fin} (fin = os.clock() de fin de service)
local function lancerCycle(player, station, stationID, car)
	local meuble = trouverMeuble(player, stationID)
	local D = meuble and donneesStation(station.Name)
	if not (meuble and D and meuble:FindFirstChild("Socle")) then
		return {fin = os.clock() + 5}                                       -- meuble sans animation : service symbolique
	end
	local ov = meuble:FindFirstChild("VoitureCycle")
	if not ov then ov = Instance.new("ObjectValue"); ov.Name = "VoitureCycle"; ov.Parent = meuble end
	ov.Value = car
	meuble:SetAttribute("CycleDebut", workspace:GetServerTimeNow())
	return {meuble = meuble, D = D, fin = os.clock() + (D.CYCLE or 20)}
end

-- fin du cycle : la voiture reelle est posee au point de sortie de la station, le client la re-affiche
local function finirCycle(cycle, car)
	local meuble = cycle.meuble
	if meuble and meuble.Parent then
		local cf = pointStation(meuble, cycle.D, -Y_LOIN)
		if cf and car.Parent then car:PivotTo(cf) end
		meuble:SetAttribute("CycleDebut", 0)
		local ov = meuble:FindFirstChild("VoitureCycle")
		if ov then ov.Value = nil end
	end
end

-- ======================================================================================================================
-- PROVISOIRES
-- ======================================================================================================================

local function PickRandomCar(player: Player)

	local rank, probas  = PlayerData.GetRank(player)

	local rand = math.random()
	local cumulative = 0
	local tier = 1

	for i, chance in ipairs(probas) do
		cumulative = cumulative + chance
		if rand <= cumulative then
			tier = i
			break
		end
	end

	local nomTier = Car.Ordre[tier]
	local pool = Car[nomTier]
	return pool.Models[math.random(1, #pool.Models)], nomTier
end

-- ======================================================================================================================
-- STATIONS
-- ======================================================================================================================

-- Longueur des voitures clientes : par modele, d'apres la taille reelle (Car.Longueur : M4 = Car.LONGUEUR_M4 studs).
-- Les modeles partages (ReplicatedStorage > VoituresModeles) sont remis a cette taille au demarrage : les stations
-- (qui mesurent la voiture qu'elles recoivent) et la chaine (echelle relative) suivent automatiquement.
local function AjusterModeles()
	local dossier = ReplicatedStorage:FindFirstChild("VoituresModeles")
	if not dossier then return end
	local n = 0
	for _, m in ipairs(dossier:GetChildren()) do
		if m:IsA("Model") then
			local voulu = Car.Longueur(m.Name)
			local ext = m:GetExtentsSize()
			local L = math.max(ext.X, ext.Z)
			if L > 0 and math.abs(L - voulu) > 0.3 then
				m:ScaleTo(m:GetScale() * voulu / L)
				n += 1
			end
		end
	end
	if n > 0 then print(("[Cars] %d modele(s) de VoituresModeles remis a l'echelle (M4 = %d studs)"):format(n, Car.LONGUEUR_M4)) end
end
AjusterModeles()
CarManager.AjusterModeles = AjusterModeles
local VITESSE = 32               -- vitesse des voitures sur la route (studs/s) : 45 etait trop rapide a l'echelle des joueurs
local CADENCE_MIN, CADENCE_MAX = 14, 24   -- secondes entre deux clients d'un joueur (cadence volontairement basse pour l'instant)

-- Direction avant d'un modele de voiture d'apres ses roues : centre des roues avant - centre des roues arriere
-- (memes conventions de noms que Stations/Voiture : roue/wheel/pneu/tire ; AV/FL/FR/Front = avant, AR/RL/RR/Rear = arriere).
local function estRoue(n)
	n = string.lower(n)
	return n:find("wheel") or n:find("roue") or n:find("pneu") or n:find("tire") or n:find("tyre")
end
local function genreRoue(n)
	n = string.upper(n)
	if n:find("FL") or n:find("FR") or n:find("AV") or n:find("FRONT") then return 1 end
	if n:find("RL") or n:find("RR") or n:find("AR") or n:find("REAR") or n:find("BACK") then return -1 end
	return 0
end
local function SensDeMarche(car)
	local sommeAV, nAV, sommeAR, nAR = Vector3.zero, 0, Vector3.zero, 0
	for _, p in ipairs(car:GetDescendants()) do
		if p:IsA("BasePart") then
			local cle = nil
			local a = p.Parent
			while a and a ~= car do
				if a:IsA("Model") and estRoue(a.Name) then cle = a.Name end
				a = a.Parent
			end
			if not cle and estRoue(p.Name) then cle = p.Name end
			if cle then
				local g = genreRoue(cle)
				if g == 1 then sommeAV += p.Position; nAV += 1
				elseif g == -1 then sommeAR += p.Position; nAR += 1 end
			end
		end
	end
	if nAV == 0 or nAR == 0 then return nil end
	local d = sommeAV / nAV - sommeAR / nAR
	d = Vector3.new(d.X, 0, d.Z)
	if d.Magnitude < 0.5 then return nil end
	return d.Unit
end

-- longueur (facultatif) : longueur voulue du vehicule en studs (defaut : Car.Longueur(nom du modele) ; le camion de
-- livraison passe la sienne)
local function SpawnCar(carTemplate, longueur)

	local car = carTemplate:Clone()
	longueur = longueur or Car.Longueur(carTemplate.Name)

	-- mise a l'echelle (les modeles sources importes font ~29 studs)
	local ext = car:GetExtentsSize()
	local L = math.max(ext.X, ext.Z)
	if L > 0 and math.abs(L - longueur) > 0.3 then
		car:ScaleTo(car:GetScale() * longueur / L)
	end

	local centre, taille = car:GetBoundingBox()

	-- Sens de marche : le Root regarde vers l'AVANT de la voiture (LookVector), quel que soit le sens dans lequel le
	-- modele a ete importe. L'avant = le cote des roues avant (Roue_AV*, *FL/FR/Front) par rapport aux roues arriere ;
	-- sans roues nommees, l'axe horizontal le plus long de la boite, dans le sens actuel du modele.
	local avant = SensDeMarche(car) or ((taille.X > taille.Z) and centre.RightVector or centre.LookVector)
	avant = Vector3.new(avant.X, 0, avant.Z)
	if avant.Magnitude < 1e-3 then avant = centre.LookVector end
	local bas = centre.Position - Vector3.new(0, taille.Y / 2, 0)

	local racine = Instance.new("Part")
	racine.Name = "Root"
	racine.Size = Vector3.new(1, 1, 1)
	racine.Transparency = 1
	racine.CanCollide = false
	racine.CanQuery = false
	racine.CanTouch = false
	racine.Anchored = true
	racine.CFrame = CFrame.lookAt(bas, bas + avant.Unit)
	racine.Parent = car

	for _, piece in ipairs(car:GetDescendants()) do
		if piece:IsA("BasePart") and piece ~= racine then
			piece.CanCollide = false
			piece.CanQuery = false
			piece.CanTouch = false
			piece.Anchored = false

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = racine
			weld.Part1 = piece
			weld.Parent = racine
		end
	end

	car.PrimaryPart = racine
	-- la voiture arrive entiere chez les joueurs (StreamingEnabled) : le client des stations la mesure et la copie
	pcall(function() car.ModelStreamingMode = Enum.ModelStreamingMode.Atomic end)

	return car
end

-- Fait rouler la voiture jusqu'a 'target' (BasePart ou CFrame) le long d'une courbe de Bezier (tween cote client),
-- en attendant la fin du trajet. Vitesse : VITESSE studs/s.
-- vitesse (facultatif) : studs/s pour ce trajet (defaut VITESSE = vitesse de route) ; voir Circulation.VITESSE_*
-- etat (facultatif) : etat d'animation force (4 = derapage, camion de livraison v49)
local function AnimationNodeCar(car, target, last, vitesse, etat)
	local root = car.PrimaryPart
	if not root then return end

	local startCFrame = root.CFrame
	local targetCFrame = (typeof(target) == "CFrame") and target or target.CFrame

	local duree = 0
	local p0 = startCFrame.Position
	local p2 = targetCFrame.Position
	local k = (p2 - p0).Magnitude * 0.39
	local controle1 = p0 + startCFrame.LookVector * k
	local controle2 = p2 - targetCFrame.LookVector * k

	local distance = 0
	local precedent = p0
	for i = 1, 20 do
		local t = i / 20
		local u = 1 - t
		local point = u^3 * p0 + 3 * u^2 * t * controle1 + 3 * u * t^2 * controle2 + t^3 * p2
		distance = distance + (point - precedent).Magnitude
		precedent = point
	end
	duree = distance / (vitesse or VITESSE)

	local etatanimation = etat or 0
	if last and not etat then
		etatanimation = 2 
	end

	MoveCarEvent:FireAllClients(car, targetCFrame, duree, etatanimation)

	task.wait(duree)

	car:PivotTo(targetCFrame)
end

-- v51 (regle de Thomas) : une station ACCUEILLE un client des qu'elle a un employe (ou qu'elle est automatique : Worker =
-- "Automatic"), MEME SANS STOCK : la voiture vient s'y garer et attend le stock sur place. Le service ne demarre qu'avec du
-- stock (etat WAITING_SERVICE).
-- v53 : service manuel (le joueur lave lui-meme avec E) : une station sans employe accepte aussi la voiture, qui attend
-- dans la station qu'un employe soit affecte ou que le joueur appuie sur E. (v51 exigeait un employe : la voiture passait.)
local function StationUtilisable(station)
	return station ~= nil
end

-- place de parking d'une station (CFrame monde) : voie du Socle du modele, sinon le milieu des cases du meuble
local function PlaceStation(player, station, stationID, pivot)
	local meuble = trouverMeuble(player, stationID)
	local cf = pointStation(meuble, meuble and donneesStation(station.Name))
	if not cf then
		cf = pivot * CFrame.new(CASE * station.X - DEMI, 0, CASE * station.Z - CASE) * CFrame.Angles(0, math.rad(station.Orientation * 90), 0)
	end
	return cf
end

-- une station est DESSERVIE si un couloir de 2 cases de goudron relie l'entree du plot a son entree, et sa sortie a la
-- sortie du plot (Circulation). Renvoie ok, cfParc, cheminAller, cheminRetour
local function StationDesservie(player, session, spawnFolder, station, stationID, carte)
	carte = carte or Circulation.Carte(player)
	if not carte then return false end
	local cf = PlaceStation(player, station, stationID, session.Pivot)
	-- v51 : seul le couloir ENTREE DU PLOT -> STATION compte pour entrer ; le couloir vers la sortie est verifie au moment de
	-- repartir (la voiture attend dans la station s'il manque)
	local ok, aller, entree = Circulation.StationDesservie(carte, session.Pivot, spawnFolder, cf)
	return ok, cf, aller, entree
end

-- une station utilisable, libre et desservie, sinon nil
local function FindStation(player, carID, session, spawnFolder)
	
	local data = PlayerData.GetData(player)
	if not data or not data.Stations then 
		return nil 
	end
	local carte = Circulation.Carte(player)

	for furnitureID, station in pairs(data.Stations) do

		if station.Service == "Available" and StationUtilisable(station) then
			if not (session and spawnFolder) or StationDesservie(player, session, spawnFolder, station, furnitureID, carte) then
				return furnitureID
			end
		end
	end

	return nil
end

-- prevenir le joueur (attribut lu par l'interface) : au plus une fois toutes les 30 s par message
local derniereAlerte = {}
local function alerter(player, texte)
	local t = os.clock()
	local d = derniereAlerte[player.UserId]
	if d and d.texte == texte and t - d.t < 30 then return end
	derniereAlerte[player.UserId] = {texte = texte, t = t}
	player:SetAttribute("Alerte", texte .. " #" .. math.floor(t))
end

-- le plot peut-il servir des clients ? (au moins une station avec employe et stock ET desservie par un couloir de
-- goudron de 2 cases de large). S'il a des stations pretes mais aucune desservie, on previent le joueur.
local function PlotPret(player, session, spawnFolder)
	local data = PlayerData.GetData(player)
	if not data or not data.Stations then return false end
	local carte = (session and spawnFolder) and Circulation.Carte(player) or nil
	local pretes, desservies = 0, 0
	for stationID, station in pairs(data.Stations) do
		if StationUtilisable(station) then
			pretes += 1
			if not carte or StationDesservie(player, session, spawnFolder, station, stationID, carte) then desservies += 1 end
		end
	end
	if pretes > 0 and desservies == 0 and carte then
		alerter(player, "Les clients ne peuvent pas entrer : il faut une route de GOUDRON de 2 cases de large, sans objet ni mur, de l'entree du plot jusqu'a l'entree d'une station avec un employe")
	end
	return desservies > 0
end

-- ======================================================================================================================
-- CAISSES
-- ======================================================================================================================

-- Y du sol sous un point du plot (dessus des dalles / du meuble) : raycast vers le bas en ignorant voitures et PNJ
local paramsSol = RaycastParams.new()
paramsSol.FilterType = Enum.RaycastFilterType.Exclude
local function YSol(player, position, defaut)
	local session = Sessions[player.UserId]
	local exclus = {}
	if session and session.Dossier then table.insert(exclus, session.Dossier) end
	local livraisons = workspace:FindFirstChild("Livraisons_" .. player.UserId)
	if livraisons then table.insert(exclus, livraisons) end
	paramsSol.FilterDescendantsInstances = exclus
	local r = workspace:Raycast(position + Vector3.new(0, 12, 0), Vector3.new(0, -30, 0), paramsSol)
	return r and r.Position.Y or defaut
end

-- CFrame du PNJ pose sur le sol a la position (x, z) voulue (garde l'orientation)
local function PoserAuSol(player, cf, pnj)
	local h = pnj and pnj:GetAttribute("HauteurPivot") or 3.616
	local y = YSol(player, cf.Position, cf.Position.Y - 3.616) + h
	return CFrame.new(cf.Position.X, y, cf.Position.Z) * (cf - cf.Position)
end

-- position de la portiere conducteur d'une voiture (a cote de la voiture, cote +X du pivot), au niveau du sol du pivot
local function PortiereCF(car)
	local cf = car:GetPivot()
	local ok, _, taille = pcall(function() return car:GetBoundingBox() end)
	local demiLargeur = (ok and taille and taille.X / 2) or 3.5
	local pos = cf.Position + cf.RightVector * (demiLargeur + 1.8)
	return CFrame.lookAt(pos, pos - cf.RightVector)
end

