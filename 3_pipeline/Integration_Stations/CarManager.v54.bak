	local X = (chemin[1].x - 0.5) * CASE
	local Z = (chemin[1].z - 0.5) * CASE - DEMI
	-- hauteur du pivot au-dessus des pieds (mesuree sur le modele) : le PNJ est pose SUR le sol reel (raycast)
	local boiteCF, boite = pnj:GetBoundingBox()
	local hauteurPivot = pnj.PrimaryPart.Position.Y - (boiteCF.Position.Y - boite.Y / 2)
	if hauteurPivot < 1 or hauteurPivot > 8 then hauteurPivot = 3.616 end
	pnj:SetAttribute("HauteurPivot", hauteurPivot)
	-- le client DESCEND DE SA VOITURE : il apparait a la portiere (cote conducteur) si on connait la voiture,
	-- sinon sur la premiere case du chemin
	local depart = (voiture and voiture.Parent) and PortiereCF(voiture) or (plotPivot * CFrame.new(X, 3.616, Z))
	pnj:PivotTo(PoserAuSol(player, depart, pnj))
	pnj.Parent = Sessions[player.UserId].Dossier

	return pnj
end

local function AnimationPNJ(player, pnj, chemin, voiture)
	local plotPivot = Sessions[player.UserId] and Sessions[player.UserId].Pivot
	if not plotPivot or not pnj or not pnj.Parent then return end

	task.wait(0.2)

	-- points a atteindre : chaque case du chemin (depuis la 1re : le PNJ part de la portiere, pas forcement sur la case),
	-- puis la portiere de la voiture si on rentre dedans
	local cibles = {}
	for i = 1, #chemin do
		local X = (chemin[i].x - 0.5) * CASE
		local Z = (chemin[i].z - 0.5) * CASE - DEMI
		table.insert(cibles, PoserAuSol(player, plotPivot * CFrame.new(X, 3.616, Z), pnj).Position)
	end
	if voiture and voiture.Parent then table.insert(cibles, PoserAuSol(player, PortiereCF(voiture), pnj).Position) end
	-- on retire les points confondus avec la position courante (pas de pas sur place)
	local etapes = {}
	local courant = pnj:GetPivot().Position
	for _, c in ipairs(cibles) do
		local d = c - courant
		if Vector3.new(d.X, 0, d.Z).Magnitude > 0.5 then table.insert(etapes, c); courant = c end
	end

	for i, ciblePos in ipairs(etapes) do
		if not pnj.Parent then return end
		local departPos = pnj:GetPivot().Position
		local direction = ciblePos - departPos
		direction = Vector3.new(direction.X, 0, direction.Z)
		if direction.Magnitude > 0.01 then
			pnj:PivotTo(CFrame.lookAt(departPos, departPos + direction))
			local cible = CFrame.lookAt(ciblePos, ciblePos + direction)        -- ciblePos est deja au sol
			local etatanimation = 1                                             -- 0 = depart, 1 = en marche, 2 = arrivee, 3 = depart + arrivee
			if #etapes == 1 then etatanimation = 3
			elseif i == 1 then etatanimation = 0
			elseif i == #etapes then etatanimation = 2 end
			-- duree proportionnelle a la distance (une case de 10 studs = 1 s ; la portiere est plus proche)
			local duree = math.clamp(direction.Magnitude / CASE, 0.35, 1.5)
			MovePnjEvent:FireAllClients(pnj, cible, duree, etatanimation)
			task.wait(duree)
			pnj:PivotTo(cible)
		end
	end
	if voiture and voiture.Parent then task.wait(0.4) end     -- le temps de "monter" dans la voiture
end

local function QueuePNJ(player, pnj, caisse, carID)
	
	local plotPivot = Sessions[player.UserId] and Sessions[player.UserId].Pivot
	if not plotPivot then return nil end
	
	local place = table.find(caisse.Queue, carID)
	if not place then return end

	local dirX, dirZ = 0, 0
	if caisse.Orientation == 0 then
		dirX, dirZ = -1, 0
	elseif caisse.Orientation == 1 then
		dirX, dirZ = 0, 1
	elseif caisse.Orientation == 2 then
		dirX, dirZ = 1, 0
	elseif caisse.Orientation == 3 then
		dirX, dirZ = 0, -1
	end


	local caisseWorldX = (caisse.X - 0.5) * CASE
	local caisseWorldZ = (caisse.Z - 0.5) * CASE - DEMI
	local recul = 0
	if caisse.Demi and caisse.CX then
		-- v54 : caisse de la demi-grille : on part du centre du meuble, et on recule de sa demi-profondeur dans le sens de la file
		caisseWorldX = (caisse.CX - 0.5) * 7.5
		caisseWorldZ = (caisse.CZ - 0.5) * 7.5 - DEMI
		recul = ((dirX ~= 0) and (caisse.DX or 1) or (caisse.DZ or 1)) * 7.5 / 2 - 1
	end

	local distances = {5, 6.5, 8, 9.5}
	local d = (distances[place] or 9.5) + recul

	local posPNJ    = PoserAuSol(player, plotPivot * CFrame.new(caisseWorldX + dirX * d, 3.616, caisseWorldZ + dirZ * d), pnj)
	local posCaisse = plotPivot * CFrame.new(caisseWorldX, posPNJ.Position.Y, caisseWorldZ)

	pnj:PivotTo(CFrame.lookAt(posPNJ.Position, posCaisse.Position))
end

-- Chemin d'un PNJ sur la grille (1 case de large, 4 directions) : Circulation.CheminPieton (teste hors ligne)
local function PathToCaisse(player, startX, startZ, cibleX, cibleZ, strict)
	local Grid = PlayerData.GetGrid(player)
	if not Grid then return nil end
	local nx, nz = PlayerData.GetPlotSize(player)
	nx = nx or PlayerData.MAX_X; nz = nz or PlayerData.MAX_Z
	return Circulation.CheminPieton(Grid, nx, nz, startX, startZ, cibleX, cibleZ, strict, PlayerData.GetDemi and PlayerData.GetDemi(player, false) or nil)
end

-- chemin d'un PNJ : d'abord en evitant meubles et murs ; sinon on previent le joueur et on laisse passer (pas de blocage)
local function CheminPNJ(player, startX, startZ, cibleX, cibleZ)
	local ok, chemin = PathToCaisse(player, startX, startZ, cibleX, cibleZ, true)
	if ok then return ok, chemin end
	alerter(player, "Un client ne trouve pas de passage a pied (1 case de large, sans objet ni mur) entre la station et la caisse : degage un chemin")
	return PathToCaisse(player, startX, startZ, cibleX, cibleZ, false)
end

local function FindCaisse(player) 

	local data = PlayerData.GetData(player)
	if not data or not data.Caisses then 
		return nil 
	end
	
	for furnitureID, caisse in pairs(data.Caisses) do

		if caisse.Service == "Available" and #caisse.Queue <= 3 then

			return furnitureID
		end
	end

	return nil
end


-- ======================================================================================================================
-- BOUCLE
-- ======================================================================================================================


local function nbNoeudsDe(spawnFolder) return #spawnFolder.QueueNodes:GetChildren() end

-- ======================================================================================================================
-- v53 : OBSERVATEURS (tutoriel) et SERVICE MANUEL (le joueur lave / encaisse lui-meme avec E quand il n'y a pas d'employe)
-- ======================================================================================================================
local Observateurs = {}          -- [userId] = function(evenement, car, infos)  evenements : entre, gare, service, caisse, encaisse, paye, parti
function CarManager.Observer(player, fn) Observateurs[player.UserId] = fn end
local function notifier(player, evenement, car, infos)
	local f = Observateurs[player.UserId]
	if f then task.spawn(pcall, f, evenement, car, infos) end
end

-- invite "E" sur un meuble (station : "Laver", caisse : "Encaisser"), reservee au proprietaire ; renvoie l'invite
-- Invites "E" (service manuel) : une piece invisible InviteService au centre du meuble porte un ProximityPrompt (E) ET
-- un panneau "E - Laver la voiture" visible de loin ; le client (ClientService) peut aussi declencher par la touche E via le
-- RemoteEvent ServiceManuelEvent (secours si l'invite Roblox ne s'affiche pas). Une seule invite par meuble.
local Invites = {}               -- [meuble] = { player = Player, fn = function() }
local ServiceManuelEvent = ReplicatedStorage:FindFirstChild("ServiceManuelEvent")
if not ServiceManuelEvent then
	ServiceManuelEvent = Instance.new("RemoteEvent"); ServiceManuelEvent.Name = "ServiceManuelEvent"; ServiceManuelEvent.Parent = ReplicatedStorage
end
local function declencherInvite(player, meuble)
	local inv = Invites[meuble]
	if not (inv and inv.player == player) then return false end
	local racine = meuble:FindFirstChild("InviteService")
	local perso = player.Character
	local root = perso and perso:FindFirstChild("HumanoidRootPart")
	if racine and root and (racine.Position - root.Position).Magnitude > 34 then return false end
	inv.fn()
	return true
end
ServiceManuelEvent.OnServerEvent:Connect(function(player, meuble)
	if typeof(meuble) == "Instance" then declencherInvite(player, meuble) end
end)

local function inviteSur(player, meuble, action, texte, fn)
	if not meuble then return nil end
	Invites[meuble] = { player = player, fn = fn or function() end }
	local racine = meuble:FindFirstChild("InviteService")
	if racine then
		local p = racine:FindFirstChild("ServiceManuel")
		if p then p.ActionText = action; p.ObjectText = texte or "" end
		local l = racine:FindFirstChild("Panneau") and racine.Panneau:FindFirstChild("Texte")
		if l then l.Text = action end
		return p
	end
	-- la piece est au pivot du meuble (sa case : centre d'une station, case d'ancrage d'une caisse). Pas la boite
	-- englobante : celle d'une station peut etre enorme (pieces annexes loin du meuble), ni le Socle (petite piece dans un coin).
	local ok, pivot = pcall(function() return meuble:GetPivot() end)
	if not ok then return nil end
	racine = Instance.new("Part"); racine.Name = "InviteService"; racine.Anchored = true; racine.CanCollide = false
	racine.CanTouch = false; racine.Transparency = 1; racine.Size = Vector3.new(1, 1, 1); racine.CastShadow = false
	racine.CFrame = CFrame.new(pivot.Position + Vector3.new(0, 4, 0))
	racine:SetAttribute("Proprietaire", player.UserId)
	local p = Instance.new("ProximityPrompt"); p.Name = "ServiceManuel"
	p.KeyboardKeyCode = Enum.KeyCode.E; p.HoldDuration = 0.35; p.MaxActivationDistance = 26
	p.RequiresLineOfSight = false; p.Style = Enum.ProximityPromptStyle.Default
	p.ActionText = action; p.ObjectText = texte or ""; p.Parent = racine
	p.Triggered:Connect(function(qui) declencherInvite(qui, meuble) end)
	-- panneau visible de loin
	local bb = Instance.new("BillboardGui"); bb.Name = "Panneau"; bb.Size = UDim2.new(0, 230, 0, 56); bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true; bb.MaxDistance = 90; bb.LightInfluence = 0
	local fond = Instance.new("Frame"); fond.Size = UDim2.fromScale(1, 1); fond.BackgroundColor3 = Color3.fromRGB(18, 20, 28); fond.BackgroundTransparency = 0.2
	fond.BorderSizePixel = 0; fond.Parent = bb
	local coin = Instance.new("UICorner"); coin.CornerRadius = UDim.new(0, 12); coin.Parent = fond
	local touche = Instance.new("TextLabel"); touche.Name = "Touche"; touche.Size = UDim2.new(0, 40, 0, 40); touche.Position = UDim2.new(0, 8, 0.5, 0)
	touche.AnchorPoint = Vector2.new(0, 0.5); touche.BackgroundColor3 = Color3.new(1, 1, 1); touche.Text = "E"; touche.Font = Enum.Font.GothamBlack
	touche.TextSize = 26; touche.TextColor3 = Color3.fromRGB(18, 20, 28); touche.Parent = fond
	local coin2 = Instance.new("UICorner"); coin2.CornerRadius = UDim.new(0, 8); coin2.Parent = touche
	local l = Instance.new("TextLabel"); l.Name = "Texte"; l.Position = UDim2.new(0, 56, 0, 0); l.Size = UDim2.new(1, -62, 1, 0); l.BackgroundTransparency = 1
	l.Text = action; l.Font = Enum.Font.GothamBold; l.TextSize = 19; l.TextColor3 = Color3.new(1, 1, 1); l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true; l.Parent = fond
	bb.Parent = racine
	racine.Parent = meuble
	return p
end
local function retirerInvite(meuble)
	if not meuble then return end
	Invites[meuble] = nil
	local r = meuble:FindFirstChild("InviteService"); if r then r:Destroy() end
end

local function CarLifecycle(car, player, spawnFolder)

	local carID = car.Name
	local session = Sessions[player.UserId]
	if not session then return end
	if car:GetAttribute("Achetee") == true then
		-- voiture achetee au centre : prioritaire, devant tous les clients venus du tunnel (mais derriere une autre achetee)
		local rang = 1
		for i, id in ipairs(session.Queue) do
			local autre = session.Dossier:FindFirstChild(id)
			if autre and autre:GetAttribute("Achetee") == true then rang = i + 1 end
		end
		table.insert(session.Queue, rang, carID)
	else
		table.insert(session.Queue, carID)
	end
	local position = 0
	local achetee = car:GetAttribute("Achetee") == true                   -- voiture achetee au centre (prioritaire, arrive par la route)

	local stationID = nil
	local caisseID = nil
	local caisse = nil
	local station = nil
	
	local startX, startZ, cibleX, cibleZ = nil
	
	local last = 0
	
	local pnj= nil

	local cycle = nil            -- cycle de la station en cours : {meuble, D, fin}
	local sortieNoeuds = nil     -- v54 : dossier des noeuds de la sortie choisie (Sorties/<bx>)
	local lave = false           -- vrai quand le cycle de la station est termine (la voiture peut repartir / etre payee)
	local attente = nil          -- debut de l'attente d'une caisse (FIND_CAISSE) : sert a prevenir le joueur (v51 : le client attend, il ne part plus sans payer)

	local state = "CAR_QUEUE"

	while car.Parent do
		local data = PlayerData.GetData(player)
		if not data then break end

		-- fin du cycle de la station (quel que soit l'etat : le PNJ peut encore etre a la caisse)
		if cycle and not lave and os.clock() >= cycle.fin then
			lave = true
			finirCycle(cycle, car)
		end

		-- =========================================================================
		-- ÉTAT 1 : AVANCEMENT DANS LA FILE D'ATTENTE GÉNÉRALE
		-- =========================================================================
		if state == "CAR_QUEUE" then
			-- Regles de la file :
			--   * les noeuds 1 (devant l'entree) et 2 (carrefour) sont un COULOIR DE PASSAGE : personne n'y attend. Les
			--     clients venus du tunnel attendent sur la branche a partir du noeud 3 ; les voitures achetees au centre
			--     attendent sur la route du tour avant le carrefour. On ne descend au noeud 2 / 1 que pour entrer.
			--   * une voiture achetee au centre est prioritaire : elle est inseree en tete de file.
			--   * si le plot n'a AUCUNE station utilisable (employe + stock), la voiture ne s'arrete pas : elle passe
			--     devant le plot et continue jusqu'au despawn (trajet de sortie).
			local newposition = table.find(session.Queue, carID)
			local nbNoeuds = #spawnFolder.QueueNodes:GetChildren()          -- autant de places dans la file que de noeuds

			if newposition then
				if not PlotPret(player, session, spawnFolder) then
					state = "PASSE"
				elseif achetee then
					-- place d'attente (position p -> place p sur la route du tour)
					if newposition ~= position then
						position = newposition
						local target = CarManager.PlaceAttenteAchat(spawnFolder, position)
						if target then AnimationNodeCar(car, target, true); task.wait(0.3) end
					end
					if position == 1 then state = "FIND_STATION" end
				else
					-- clients du tunnel : position p -> noeud p + 2 (le noeud 3 est la tete de file), jamais au-dela du dernier noeud
					local cible = math.min(newposition + 2, nbNoeuds)
					if position == 0 then position = nbNoeuds + 1 end
					while position > cible do
						position = position - 1
						local target = spawnFolder.QueueNodes:FindFirstChild(tostring(position))
						if target then
							local lastnode = (position == cible)
							AnimationNodeCar(car, target, lastnode)
							if lastnode then task.wait(0.3) end
						end
					end
					if newposition == 1 then state = "FIND_STATION" end
				end
			end

			-- =========================================================================
			-- ÉTAT 1 bis : LE PLOT NE PEUT PAS SERVIR -> LA VOITURE PASSE SON CHEMIN JUSQU'AU DESPAWN
			-- =========================================================================
		elseif state == "PASSE" then
			local idx = table.find(session.Queue, carID)
			if idx then table.remove(session.Queue, idx) end
			if not achetee then
				-- depuis la branche : descend la file jusqu'au carrefour puis devant l'entree
				if position == 0 then position = nbNoeudsDe(spawnFolder) + 1 end
				while position > 1 do
					position = position - 1
					local target = spawnFolder.QueueNodes:FindFirstChild(tostring(position))
					if target then AnimationNodeCar(car, target, position == 1) end
				end
			end
			-- puis la route du tour : noeuds Passage (v54 : voie exterieure depuis le carrefour, puis la queue fixe) ; a defaut
			-- l'ancien trajet de sortie a partir du noeud 3 (le 1 est dans le plot, le 2 sur le trottoir)
			local passage = spawnFolder:FindFirstChild("Passage")
			local i = passage and 1 or 3
			local source = passage or spawnFolder:FindFirstChild("ExitNodes")
			local target = source and source:FindFirstChild(tostring(i))
			while target do
				AnimationNodeCar(car, target, false)
				i = i + 1
				target = source:FindFirstChild(tostring(i))
			end
			car:Destroy()
			break

			-- =========================================================================
			-- ÉTAT 2 : RECHERCHE D'UNE STATION DISPONIBLE
			-- =========================================================================
		elseif state == "FIND_STATION" then
			
			-- toujours en tete de file ? (une voiture achetee au centre a pu s'inserer devant : elle passe d'abord)
			if table.find(session.Queue, carID) ~= 1 then
				state = "CAR_QUEUE"
				continue
			end
			stationID = FindStation(player, carID, session, spawnFolder)
			station = data.Stations and data.Stations[stationID]
			if station then
				local okRoute, cf, aller, entree = StationDesservie(player, session, spawnFolder, station, stationID)
				if not okRoute then
					-- la route a change entre-temps : on reprend la file
					state = "CAR_QUEUE"
					continue
				end
				table.remove(session.Queue, 1)
				state = "WAITING_SERVICE"
				station.Car = carID
				station.Service = "Taken"

				-- conduite : on ralentit au carrefour (noeud 2 puis 1 pour les clients du tunnel ; noeud 1 seul pour une
				-- voiture venue de la route), on entre dans le plot doucement, on suit le couloir de goudron (points de
				-- virage, plus lent dans les virages), puis on se gare dans la voie de la station.
				local yPlot = Circulation.YPlot(spawnFolder, session.Pivot)
				if car:GetAttribute("Achetee") == true then
					-- v51 : la voiture achetee attend sur la route du tour : carrefour, puis devant l'entree sur la voie opposee
					local an = spawnFolder:FindFirstChild("AchatNodes")
					local a1 = an and an:FindFirstChild("1")
					if a1 then AnimationNodeCar(car, a1, false, Circulation.VITESSE_APPROCHE) end
					local a2 = (entree and entree:FindFirstChild("Achat")) or (an and an:FindFirstChild("2"))
					if a2 then AnimationNodeCar(car, a2, false, Circulation.VITESSE_APPROCHE) end
				else
					local n2 = spawnFolder.QueueNodes:FindFirstChild("2")
					if n2 then AnimationNodeCar(car, n2, false, Circulation.VITESSE_APPROCHE) end
					local n1 = spawnFolder.QueueNodes:FindFirstChild("1")
					if n1 then AnimationNodeCar(car, n1, false, Circulation.VITESSE_APPROCHE) end
				end
				-- v51 : l'entree est sur la branche ; la voiture franchit le trottoir (noeud EntreeTrottoir) puis entre
				-- v54 : l'entree choisie (bloc de goudron ouvert, Circulation.Entrees) ; a defaut l'entree principale
				entree = entree or spawnFolder:FindFirstChild("Entree")
				local trottoir = (entree and entree:FindFirstChild("Trottoir")) or spawnFolder:FindFirstChild("EntreeTrottoir")
				if trottoir then AnimationNodeCar(car, trottoir, false, Circulation.VITESSE_APPROCHE) end
				if entree then AnimationNodeCar(car, entree, false, Circulation.VITESSE_PLOT) end
				notifier(player, "entre", car, {stationID = stationID})
				local cfEntreeStation = Circulation.PointsStation(cf)
				local carte = Circulation.Carte(player)
				if carte and aller then
					for _, etape in ipairs(Circulation.Trajet(carte, session.Pivot, aller, yPlot, cfEntreeStation.LookVector)) do
						if not car.Parent then break end
						AnimationNodeCar(car, etape.cf, false, etape.vitesse)
					end
				end
				if car.Parent then AnimationNodeCar(car, cfEntreeStation, false, Circulation.VITESSE_STATION) end
				if car.Parent then AnimationNodeCar(car, cf, true, Circulation.VITESSE_STATION) end
				if car.Parent then car:PivotTo(cf) end
				notifier(player, "gare", car, {stationID = stationID})
			end


			-- =========================================================================
			-- ÉTAT 4 : ATTENTE DES RESSOURCES / EMPLOYÉ À LA STATION
			-- =========================================================================
		elseif state == "WAITING_SERVICE" then
			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				break
			end

			-- v53 : sans employe, le joueur peut laver lui-meme : invite "E" sur la station (ServiceManuel)
			if station.Worker == nil and (station.Quantity or 0) > 0 and not station.ServiceManuel then
				local meuble = trouverMeuble(player, stationID)
				inviteSur(player, meuble, "Laver la voiture", "Station", function()
					local st = PlayerData.GetData(player); st = st and st.Stations and st.Stations[stationID]
					if st and st.Worker == nil then st.ServiceManuel = true end
				end)
			end
			if (station.Quantity or 0) > 0 and (station.Worker ~= nil or station.ServiceManuel) then
				-- le service commence : la station s'anime avec cette voiture chez tous les joueurs,
				-- pendant ce temps le client (PNJ) va payer a la caisse
				station.ServiceManuel = nil
				retirerInvite(trouverMeuble(player, stationID))
				cycle = lancerCycle(player, station, stationID, car)
				lave = false
				state = "FIND_CAISSE"
				notifier(player, "service", car, {stationID = stationID})
			elseif (station.Quantity or 0) <= 0 then
				alerter(player, "Un client attend dans une station sans stock : commande du stock (onglet Stock)")
			else
				alerter(player, "Un client attend dans une station sans employe : approche-toi et appuie sur E pour laver, ou embauche quelqu'un (onglet Equipe)")
			end
	
			-- =========================================================================
			-- ÉTAT 5 : RECHERCHE D'UNE CAISSE ET DU CHEMIN ALLER
			-- =========================================================================
		elseif state == "FIND_CAISSE" then
			
			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				break
			end

			caisseID = FindCaisse(player)
			if caisseID and data.Caisses and data.Caisses[caisseID] then
				caisse = data.Caisses[caisseID]

				local infosMeuble = Catalogue.GetInfo("Furniture", station.Name)
				if infosMeuble and infosMeuble.Pivot == "centre" then
					startX, startZ = station.X, station.Z            -- pivot central : le PNJ part du milieu de la station
				elseif station.Orientation == 0 then
					startX, startZ = station.X + 1, station.Z - 1
				elseif station.Orientation == 1 then
					startX, startZ = station.X - 1, station.Z + 1
				elseif station.Orientation == 2 then
					startX, startZ = station.X - 1, station.Z + 1
				elseif station.Orientation == 3 then
					startX, startZ = station.X + 1, station.Z - 1	
				end

				if caisse.Demi and caisse.CX then
					-- v54 : caisse de la demi-grille : la case qui contient la demi-case devant le centre du meuble
					local dX, dZ = 0, 0
					if caisse.Orientation == 0 then dX = -1 elseif caisse.Orientation == 2 then dX = 1
					elseif caisse.Orientation == 3 then dZ = -1 else dZ = 1 end
					local hx = caisse.CX + dX * ((caisse.DX or 1) / 2 + 0.5)
					local hz = caisse.CZ + dZ * ((caisse.DZ or 1) / 2 + 0.5)
					cibleX, cibleZ = math.ceil(hx / 2), math.ceil(hz / 2)
				elseif caisse.Orientation == 0 then
					cibleX, cibleZ = caisse.X - 1, caisse.Z
				elseif caisse.Orientation == 3 then
					cibleX, cibleZ = caisse.X, caisse.Z - 1
				elseif caisse.Orientation == 2 then
					cibleX, cibleZ = caisse.X + 1, caisse.Z 
				elseif caisse.Orientation == 1 then
					cibleX, cibleZ = caisse.X, caisse.Z + 1	
				end 

				local succes, chemin = CheminPNJ(player, startX, startZ, cibleX, cibleZ)
				if succes then
					if PlayerData.JoinQueue(player, caisseID, carID) then
						
						-- le client descend de sa voiture et marche jusqu'a la caisse (1 case de large, sans mur ni meuble)
						pnj = SpawnPNJ(player, chemin, car)
						AnimationPNJ(player, pnj, chemin)
						QueuePNJ(player,pnj,caisse,carID)
						
						last = 0
						attente = nil
						state = "QUEUE_CAISSE"
						notifier(player, "caisse", car, {caisseID = caisseID, pnj = pnj})
					end
				end
			end
			-- v51 (regle de Thomas) : pas de caisse (ou pas de chemin a pied) -> le client ATTEND dans la station qu'une
			-- caisse soit posee et accessible (plus de depart sans payer) ; on previent le joueur
			if state == "FIND_CAISSE" then
				attente = attente or os.clock()
				if os.clock() - attente > 8 then
					alerter(player, caisseID and "Un client ne trouve pas de passage a pied (1 case de large, sans objet ni mur) de la station a la caisse"
						or "Un client attend pour payer : pose une CAISSE (et un chemin a pied depuis la station)")
				end
			end

			-- =========================================================================
			-- ÉTAT 6 : ATTENTE DANS LA FILE DE LA CAISSE ET PAIEMENT
			-- =========================================================================
		elseif state == "QUEUE_CAISSE" then

			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				PlayerData.LeaveQueue(player, caisseID, carID)
				pnj:Destroy()
				break
			end
			
			if not data.Caisses or not data.Caisses[caisseID] then
				pnj:Destroy()
				caisseID = nil
				caisse = nil
				state = "FIND_CAISSE"
				continue
			end

			caisse = data.Caisses[caisseID]
			local place = table.find(caisse.Queue, carID)

			if place and place ~= last then
				last = place
				QueuePNJ(player,pnj,caisse,carID)
			end

			if place == 1 and caisse.Worker == nil and not caisse.EncaissementManuel then
				-- v53 : sans employe, le joueur encaisse lui-meme (invite "E" sur la caisse)
				local meuble = trouverMeuble(player, caisseID)
				inviteSur(player, meuble, "Encaisser", "Caisse", function()
					local d2 = PlayerData.GetData(player); local c2 = d2 and d2.Caisses and d2.Caisses[caisseID]
					if c2 and c2.Worker == nil then c2.EncaissementManuel = true end
				end)
				alerter(player, "Un client attend a la caisse : approche-toi et appuie sur E pour encaisser, ou mets un employe a la caisse (onglet Equipe)")
			end
			if place == 1 and (caisse.Worker ~= nil or caisse.EncaissementManuel) then
				caisse.EncaissementManuel = nil
				retirerInvite(trouverMeuble(player, caisseID))
				notifier(player, "encaisse", car, {caisseID = caisseID})
				task.wait(3)
				station = data.Stations and data.Stations[stationID]

				if station then
					-- le client a paye : il RETOURNE A SA VOITURE (meme regle de passage : 1 case de large, sans mur ni
					-- meuble), monte dedans, et c'est la voiture qui repart par le couloir de goudron (etats COMPLETED ->
					-- WAIT_EXIT -> EXIT). Le client ne quitte jamais le plot a pied.
					local succes, chemin = CheminPNJ(player, cibleX, cibleZ, startX, startZ)
					PlayerData.LeaveQueue(player, caisseID, carID)
					if succes then
						AnimationPNJ(player, pnj, chemin, car)
					else
						-- plus aucun sol entre la caisse et la station : on le ramene directement a la portiere
						alerter(player, "Un client ne trouve plus de chemin pour retourner a sa voiture : il y est ramene directement")
						AnimationPNJ(player, pnj, {}, car)
					end
					pnj:Destroy()
					pnj = nil
					state = "COMPLETED"
					notifier(player, "paye", car)
				end
			end
 
			-- =========================================================================
			-- ÉTAT 7 : FINALISATION DU SERVICE ET NETTOYAGE
		elseif state == "COMPLETED" then
			-- le paiement est encaisse quand le lavage / le service est termine (on attend la fin du cycle)
			if lave then
				station = data.Stations and data.Stations[stationID]
				if station then

					local infos = Catalogue.GetInfo("Consommable", station.Item)

					local Name = car:GetAttribute("Name")
					local Tier =  car:GetAttribute("Tier")

					if infos and Car[Tier] then
						-- mutation (script Mutations) : une voiture en or paie x3, en argent x2, electrique x1,5
						local mutation = car:GetAttribute("Mutation")
						local bonus = (mutation == "Or" and 3) or (mutation == "Argent" and 2) or (mutation == "Electrique" and 1.5) or 1
						PlayerData.AddMoney(player, math.floor((infos.Buy +  (infos.Sell - infos.Buy) * Car[Tier].Mult * (station.Mult or 1)) * bonus + 0.5))
						PlayerData.AddXp(player,50* Car[Tier].Mult)
						PlayerData.RemoveItemStation(player, stationID)
						PlayerData.AddCar(player, Name, Tier)
					end
				end

				state = "WAIT_EXIT"
			end
		
			-- =========================================================================
			-- ÉTAT 7 bis : CLIENT PARTI SANS PAYER (aucune caisse accessible) -> la voiture repart quand le cycle est fini
			-- =========================================================================
		elseif state == "ABANDON" then
			if lave then
				if pnj then pnj:Destroy(); pnj = nil end
				state = "WAIT_EXIT"
			end

			-- =========================================================================
			-- ÉTAT 8 : ATTENTE QUE LE NODE 1 DE SORTIE SOIT LIBRE
			-- =========================================================================
		elseif state == "WAIT_EXIT" then
			-- v51 (regle de Thomas) : la voiture ne repart que s'il y a un couloir de goudron (2 cases) de la sortie de la
			-- station jusqu'a la SORTIE du plot ; sinon elle attend dans la station (et le joueur est prevenu)
			local carte = Circulation.Carte(player)
			local retour, dossierSortie = nil, nil
			if carte then retour, dossierSortie = Circulation.CheminSortie(carte, session.Pivot, spawnFolder, car:GetPivot()) end
			if not retour then
				alerter(player, "Un client ne peut pas repartir : il faut une route de GOUDRON de 2 cases de large de la sortie de sa station jusqu'a la SORTIE du plot")
			elseif not session.Exit then
				session.Exit = carID

				station = data.Stations and data.Stations[stationID]
				if station then
					station.Car = nil
					station.Service = "Available"
				end

				-- la voiture redemarre doucement, sort de la voie de la station, suit le couloir de goudron jusqu'a la
				-- sortie du plot (ExitNodes/1), puis reaccelere sur la route (etat EXIT)
				sortieNoeuds = dossierSortie or spawnFolder:FindFirstChild("ExitNodes")
				local premier = sortieNoeuds and sortieNoeuds:FindFirstChild("1")
				local _, cfSortieStation = Circulation.PointsStation(car:GetPivot())
				AnimationNodeCar(car, cfSortieStation, false, Circulation.VITESSE_STATION)
				if premier then
					local yPlot = Circulation.YPlot(spawnFolder, session.Pivot)
					for _, etape in ipairs(Circulation.Trajet(carte, session.Pivot, retour, yPlot, premier.CFrame.LookVector)) do
						if not car.Parent then break end
						AnimationNodeCar(car, etape.cf, false, etape.vitesse)
					end
				end
				if premier and car.Parent then AnimationNodeCar(car, premier, false, Circulation.VITESSE_PLOT) end
				state = "EXIT"
				notifier(player, "parti", car)
			end

			-- =========================================================================
			-- ÉTAT 9 : SORTIE PAR LES NODES
			-- =========================================================================
		elseif state == "EXIT" then
			local i = 2
			local source = sortieNoeuds or spawnFolder:FindFirstChild("ExitNodes")
			local target = source and source:FindFirstChild(tostring(i))

			while target do
				AnimationNodeCar(car, target, false, (i <= 3) and Circulation.VITESSE_APPROCHE or nil)

				if session.Exit == carID then
					session.Exit = nil
				end

				i = i + 1
				target = source:FindFirstChild(tostring(i))
			end
			if session.Exit == carID then session.Exit = nil end

			car:Destroy()
			break
		end

		task.wait(1)
	end

	-- la voiture a disparu en plein cycle (station detruite, joueur parti...) : la station ne doit pas rester "en service"
	if cycle and not lave then finirCycle(cycle, car) end
end

-- ======================================================================================================================
-- GESTION DU GENERATEUR
-- ======================================================================================================================

-- utilises aussi par les voitures d'ambiance (CarAmbiance)
CarManager.SpawnCar = SpawnCar
CarManager.AnimationNodeCar = AnimationNodeCar

-- ======================================================================================================================
-- VOITURES ACHETEES AU CENTRE (CarAmbiance) : elles deviennent des clientes du plot de l'acheteur
-- ======================================================================================================================
local ESPACE_ATTENTE = 30          -- studs entre deux voitures qui attendent sur la route du tour (voitures de ~22 studs)
local RECUL_ATTENTE = 65           -- de l'entree (noeud 1) au carrefour de la branche (35) + demi-route et marge (30)

-- place d'attente k (1 = la plus proche) sur la route du tour, avant le carrefour, dans le sens de la file (noeud 1)
function CarManager.PlaceAttenteAchat(spawnFolder, k)
	local att = spawnFolder:FindFirstChild("AttenteAchat")
	if att then
		-- v51 : noeud AttenteAchat du PlotSpawn (route du tour, 36 studs avant le carrefour de la branche)
		return att.CFrame - att.CFrame.LookVector * (ESPACE_ATTENTE * (k - 1))
	end
	local n1 = spawnFolder:FindFirstChild("QueueNodes") and spawnFolder.QueueNodes:FindFirstChild("1")
	if not n1 then return nil end
	local cf = n1.CFrame
	return cf - cf.LookVector * (RECUL_ATTENTE + ESPACE_ATTENTE * (k - 1))
end

-- point ou la voiture achetee doit arriver (derniere place d'attente possible = fin du trajet depuis le centre)
function CarManager.ArriveeAchat(player)
	local session = Sessions[player.UserId]
	if not session or not session.SpawnFolder then return nil end
	local n = 1
	for _, id in ipairs(session.Queue) do
		local autre = session.Dossier:FindFirstChild(id)
		if autre and autre:GetAttribute("Achetee") == true then n += 1 end
	end
	return CarManager.PlaceAttenteAchat(session.SpawnFolder, n)
end

function CarManager.PlotDe(player)
	local session = Sessions[player.UserId]
	return session and session.SpawnFolder or nil, session
end

-- la voiture (deja marquee Achetee, Tier, Name) rejoint la file du plot de l'acheteur
function CarManager.AccueillirVoitureAchetee(player, car)
	local session = Sessions[player.UserId]
	if not session or not session.Dossier.Parent then return false end
	car.Name = HttpService:GenerateGUID(false)
	car.Parent = session.Dossier
	task.spawn(function() CarLifecycle(car, player, session.SpawnFolder) end)
	return true
end

-- ======================================================================================================================
-- CINEMATIQUES DE DECOUVERTE (v50) : la premiere fois qu'un joueur voit un modele de cette table, le client joue une
-- cinematique (ClientCinematique, RemoteEvent CinematiqueEvent) ; la voiture attend dans le tunnel `attente` secondes.
-- Memorise dans le profil : data.Cinematiques[nom] = true.  /cinematique GT3 (admin) la rejoue sur la prochaine voiture.
-- ======================================================================================================================
local CINEMATIQUES = { GT3 = { attente = 9.9 } }   -- v51 : la voiture demarre quand le flash se dissipe (ClientCinematique.DUREE_HYPER + 0.3)
local CinematiqueForcee = {}
local CinematiqueEvent = ReplicatedStorage:FindFirstChild("CinematiqueEvent")
if not CinematiqueEvent then
	CinematiqueEvent = Instance.new("RemoteEvent"); CinematiqueEvent.Name = "CinematiqueEvent"; CinematiqueEvent.Parent = ReplicatedStorage
end
local function CinematiqueDecouverte(player, car, carName, rejouer)
	local C = CINEMATIQUES[carName]
	if not C then return nil end
	local data = PlayerData.GetData(player)
	if not data then return nil end
	if type(data.Cinematiques) ~= "table" then data.Cinematiques = {} end
	if data.Cinematiques[carName] and not rejouer then return nil end
	data.Cinematiques[carName] = true
	-- la voiture vient d'etre creee : elle n'est pas forcement encore repliquee chez le client (elle arrive alors nil, ou
	-- jamais si elle est hors de la zone de streaming). On envoie donc AUSSI son nom, son dossier et sa position : le
	-- client la retrouve (WaitForChild) et construit la scene a partir du modele partage (VoituresModeles).
	task.wait()
	CinematiqueEvent:FireClient(player, "voiture", car, carName, car.Name, car.Parent and car.Parent.Name or "", car:GetPivot().Position)
	return C.attente
end
function CarManager.ForcerCinematique(player, carName)
	if not CINEMATIQUES[carName] then return false, "pas de cinematique pour " .. tostring(carName) end
	CinematiqueForcee[player.UserId] = carName
	return true
end
CarManager.CINEMATIQUES = CINEMATIQUES

function CarManager.Start(player: Player, spawnfolder: Folder) 

	if Sessions[player.UserId] then return end

	local folder = workspace.Plots:FindFirstChild(player.Name .. "'s plot")
	if not folder then return end

	local dossier = Instance.new("Folder")
	dossier.Name = "Cars_" .. player.UserId
	dossier.Parent = workspace

	Sessions[player.UserId] = {
		Dossier = dossier,
		Queue = {},
		Pivot = folder.PlotCenterRef.Value:GetPivot(),
		Exit = nil,
		SpawnFolder = spawnfolder,
		Pause = false,          -- v53 (tutoriel) : plus aucune voiture spontanee
		Immediat = nil,         -- v53 : nom d'un modele a faire partir tout de suite
	}

	local tunnel = spawnfolder:FindFirstChild("Tunnel")

	task.spawn(function()
		while dossier.Parent do
			-- cadence normale, interrompue par un depart immediat (tutoriel) ; en pause, seuls les departs immediats partent
			local session = Sessions[player.UserId]
			local attente = math.random(CADENCE_MIN, CADENCE_MAX)
			local t0 = os.clock()
			while dossier.Parent and session and not session.Immediat and (session.Pause or os.clock() - t0 < attente) do task.wait(0.25) end

			if not dossier.Parent then break end

			local carID = HttpService:GenerateGUID(false)
			local carName, carTier
			if session and session.Immediat then
				carName = session.Immediat; carTier = Car.TierDe(carName) or "Common"; session.Immediat = nil
			else
				carName, carTier = PlayerData.GetFromRecoveryQueue(player)
			end
			if not carName or not carTier then
				carName, carTier = PickRandomCar(player)
			end
			-- v50 : /cinematique <voiture> (admin) : la prochaine voiture est celle-la et sa cinematique est rejouee
			local forcee = CinematiqueForcee[player.UserId]
			if forcee then
				carName, carTier = forcee, Car.TierDe(forcee) or carTier
				CinematiqueForcee[player.UserId] = nil
			end

			local carTemplate = Car.Modele(carTier, carName)
			if not carTemplate then warn("[Cars] modele introuvable : " .. tostring(carTier) .. "/" .. tostring(carName)) continue end

			local car = SpawnCar(carTemplate)

			car.Name = carID
			car:SetAttribute("Tier", carTier)
			car:SetAttribute("Name", carName)
			car.Parent = dossier
			car:PivotTo(tunnel:GetPivot())

			-- v50 : premiere apparition d'une voiture a cinematique (GT3...) : le client joue la sequence "hyperespace",
			-- la voiture attend dans le tunnel pendant ce temps
			task.wait(CinematiqueDecouverte(player, car, carName, forcee ~= nil) or 0.3)

			task.spawn(function()
				CarLifecycle(car, player, spawnfolder)
			end)
		end
	end)
end

-- v53 : place de parking (CFrame monde) d'une station du joueur, pour le tutoriel (verification des couloirs)
function CarManager.CfStation(player, stationID)
	local s = Sessions[player.UserId]
	local data = PlayerData.GetData(player)
	local st = data and data.Stations and data.Stations[stationID]
	if not (s and st) then return nil end
	return PlaceStation(player, st, stationID, s.Pivot)
end

-- v53 : tutoriel. Pause des voitures spontanees ; depart immediat d'un modele donne (renvoie la voiture creee, ou nil)
function CarManager.Pause(player, pause)
	local s = Sessions[player.UserId]
	if s then s.Pause = pause and true or false end
end
function CarManager.DepartImmediat(player, carName, delai)
	local s = Sessions[player.UserId]
	if not s then return nil end
	local avant = {}
	for _, c in ipairs(s.Dossier:GetChildren()) do avant[c] = true end
	s.Immediat = carName or "Clio4"
	local t0 = os.clock()
	while os.clock() - t0 < (delai or 5) do
		for _, c in ipairs(s.Dossier:GetChildren()) do if not avant[c] then return c end end
		task.wait(0.1)
	end
	return nil
end

function CarManager.Stop(player: Player)
	local session = Sessions[player.UserId]
	if session then
		session.Dossier:Destroy()
	end

	Sessions[player.UserId] = nil
end

return CarManager