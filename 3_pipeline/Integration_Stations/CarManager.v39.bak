local function AnimationPNJ(player, pnj, chemin, voiture)
	local plotPivot = Sessions[player.UserId] and Sessions[player.UserId].Pivot
	if not plotPivot or not pnj or not pnj.Parent then return end

	task.wait(0.2)

	-- points a atteindre : chaque case du chemin (depuis la 1re : le PNJ part de la portiere, pas forcement sur la case),
	-- puis la portiere de la voiture si on rentre dedans
	local cibles = {}
	for i = 1, #chemin do
		local X = (chemin[i].x - 0.5) * 10
		local Z = (chemin[i].z - 0.5) * 10 - 5
		table.insert(cibles, PoserAuSol(player, plotPivot * CFrame.new(X, 3.616, Z), pnj).Position)
	end
	if voiture and voiture.Parent then table.insert(cibles, PoserAuSol(player, PortiereCF(voiture), pnj).Position) end
	-- on retire les points confondus avec la position courante (pas de pas sur place)
	local etapes = {}
	local courant = pnj:GetPivot().Position
	for _, c in ipairs(cibles) do
		local d = c - courant
		if Vector3.new(d.X, 0, d.Z).Magnitude > 0.5 then table.insert(etapes, c); courant = c end
	end

	for i, ciblePos in ipairs(etapes) do
		if not pnj.Parent then return end
		local departPos = pnj:GetPivot().Position
		local direction = ciblePos - departPos
		direction = Vector3.new(direction.X, 0, direction.Z)
		if direction.Magnitude > 0.01 then
			pnj:PivotTo(CFrame.lookAt(departPos, departPos + direction))
			local cible = CFrame.lookAt(ciblePos, ciblePos + direction)        -- ciblePos est deja au sol
			local etatanimation = 1                                             -- 0 = depart, 1 = en marche, 2 = arrivee, 3 = depart + arrivee
			if #etapes == 1 then etatanimation = 3
			elseif i == 1 then etatanimation = 0
			elseif i == #etapes then etatanimation = 2 end
			-- duree proportionnelle a la distance (une case de 10 studs = 1 s ; la portiere est plus proche)
			local duree = math.clamp(direction.Magnitude / 10, 0.35, 1.5)
			MovePnjEvent:FireAllClients(pnj, cible, duree, etatanimation)
			task.wait(duree)
			pnj:PivotTo(cible)
		end
	end
	if voiture and voiture.Parent then task.wait(0.4) end     -- le temps de "monter" dans la voiture
end

local function QueuePNJ(player, pnj, caisse, carID)
	
	local plotPivot = Sessions[player.UserId] and Sessions[player.UserId].Pivot
	if not plotPivot then return nil end
	
	local place = table.find(caisse.Queue, carID)
	if not place then return end

	local dirX, dirZ = 0, 0
	if caisse.Orientation == 0 then
		dirX, dirZ = -1, 0
	elseif caisse.Orientation == 1 then
		dirX, dirZ = 0, 1
	elseif caisse.Orientation == 2 then
		dirX, dirZ = 1, 0
	elseif caisse.Orientation == 3 then
		dirX, dirZ = 0, -1
	end


	local caisseWorldX = (caisse.X - 0.5) * 10
	local caisseWorldZ = (caisse.Z - 0.5) * 10 - 5

	local distances = {5, 6.5, 8, 9.5}
	local d = distances[place] or 9.5

	local posPNJ    = PoserAuSol(player, plotPivot * CFrame.new(caisseWorldX + dirX * d, 3.616, caisseWorldZ + dirZ * d), pnj)
	local posCaisse = plotPivot * CFrame.new(caisseWorldX, posPNJ.Position.Y, caisseWorldZ)

	pnj:PivotTo(CFrame.lookAt(posPNJ.Position, posCaisse.Position))
end

-- Chemin d'un PNJ sur la grille (cases de 10 studs = 1 de large), du depart a la cible, en 4 directions.
-- strict = true : il marche sur un sol pose, sans traverser les meubles (sauf ceux du depart et de la cible : il sort de
-- la station et arrive devant la caisse) ni les murs (MurNord = bord +X de la case, MurOuest = bord -Z).
-- strict = false : ancien comportement (n'importe quel sol), utilise en secours pour ne jamais bloquer un client.
local function PathToCaisse(player, startX, startZ, cibleX, cibleZ, strict)
	
	local Grid = PlayerData.GetGrid(player)
	if not Grid then return nil end
	local nx, nz = PlayerData.GetPlotSize(player)
	nx = nx or PlayerData.MAX_X; nz = nz or PlayerData.MAX_Z

	local function case(x, z) return Grid[x] and Grid[x][z] end
	local cDepart, cCible = case(startX, startZ), case(cibleX, cibleZ)
	local meublesOK = {}       -- meubles qu'on a le droit de traverser : celui du depart et celui de la cible
	if cDepart and cDepart.FurnitureID ~= 0 then meublesOK[cDepart.FurnitureID] = true end
	if cCible and cCible.FurnitureID ~= 0 then meublesOK[cCible.FurnitureID] = true end

	local function marchable(x, z)
		local c = case(x, z)
		if not c or c.Sol == 0 then return false end
		if not strict then return true end
		if x < 1 or z < 1 or x > nx or z > nz then return false end
		if c.Furniture ~= 0 and c.Furniture ~= nil and not meublesOK[c.FurnitureID] then return false end
		return true
	end
	local function mur(x, z, dx, dz)
		if not strict then return false end
		local c = case(x, z)
		if dx == 1 then return c and c.MurNord ~= 0 and c.MurNord ~= nil end
		if dx == -1 then local v = case(x - 1, z); return v and v.MurNord ~= 0 and v.MurNord ~= nil end
		if dz == -1 then return c and c.MurOuest ~= 0 and c.MurOuest ~= nil end
		if dz == 1 then local v = case(x, z + 1); return v and v.MurOuest ~= 0 and v.MurOuest ~= nil end
		return false
	end
	
	local directions = {
		{x = 1, z = 0},  -- Droite
		{x = -1, z = 0}, -- Gauche
		{x = 0, z = 1},  -- Bas
		{x = 0, z = -1}  -- Haut
	}

	local frontiere = {} 
	local visite = {}
	local parents = {} 

	table.insert(frontiere, {x = startX, z = startZ})
	visite[startX .. "_" .. startZ] = true

	while #frontiere > 0 do

		local actuelle = table.remove(frontiere, 1)

		if actuelle.x == cibleX and actuelle.z == cibleZ then

			local chemin = {}
			local caseRemontee = actuelle

			while caseRemontee do
				table.insert(chemin, 1, {x = caseRemontee.x, z = caseRemontee.z})

				if caseRemontee.x == startX and caseRemontee.z == startZ then
					break
				end

				local indexParent = caseRemontee.x .. "_" .. caseRemontee.z
				caseRemontee = parents[indexParent]
			end

			return true, chemin
		end

		for _, dir in ipairs(directions) do
			
			local voisinX = actuelle.x + dir.x
			local voisinZ = actuelle.z + dir.z
			local voisin = voisinX .. "_" .. voisinZ

			if not visite[voisin] and marchable(voisinX, voisinZ) and not mur(actuelle.x, actuelle.z, dir.x, dir.z) then
				visite[voisin] = true

				parents[voisin] = actuelle

				table.insert(frontiere, {x = voisinX, z = voisinZ})
			end
		end
	end
	
	return nil 
end

-- chemin d'un PNJ : d'abord en evitant meubles et murs ; sinon on previent le joueur et on laisse passer (pas de blocage)
local function CheminPNJ(player, startX, startZ, cibleX, cibleZ)
	local ok, chemin = PathToCaisse(player, startX, startZ, cibleX, cibleZ, true)
	if ok then return ok, chemin end
	alerter(player, "Un client ne trouve pas de passage a pied (1 case de large, sans objet ni mur) entre la station et la caisse : degage un chemin")
	return PathToCaisse(player, startX, startZ, cibleX, cibleZ, false)
end

local function FindCaisse(player) 

	local data = PlayerData.GetData(player)
	if not data or not data.Caisses then 
		return nil 
	end
	
	for furnitureID, caisse in pairs(data.Caisses) do

		if caisse.Service == "Available" and #caisse.Queue <= 3 then

			return furnitureID
		end
	end

	return nil
end


-- ======================================================================================================================
-- BOUCLE
-- ======================================================================================================================

local DELAI_ABANDON = 60     -- secondes sans caisse accessible avant que le client reparte sans payer (la station est liberee)

local function nbNoeudsDe(spawnFolder) return #spawnFolder.QueueNodes:GetChildren() end

local function CarLifecycle(car, player, spawnFolder)

	local carID = car.Name
	local session = Sessions[player.UserId]
	if not session then return end
	if car:GetAttribute("Achetee") == true then
		-- voiture achetee au centre : prioritaire, devant tous les clients venus du tunnel (mais derriere une autre achetee)
		local rang = 1
		for i, id in ipairs(session.Queue) do
			local autre = session.Dossier:FindFirstChild(id)
			if autre and autre:GetAttribute("Achetee") == true then rang = i + 1 end
		end
		table.insert(session.Queue, rang, carID)
	else
		table.insert(session.Queue, carID)
	end
	local position = 0
	local achetee = car:GetAttribute("Achetee") == true                   -- voiture achetee au centre (prioritaire, arrive par la route)

	local stationID = nil
	local caisseID = nil
	local caisse = nil
	local station = nil
	
	local startX, startZ, cibleX, cibleZ = nil
	
	local last = 0
	
	local pnj= nil

	local cycle = nil            -- cycle de la station en cours : {meuble, D, fin}
	local lave = false           -- vrai quand le cycle de la station est termine (la voiture peut repartir / etre payee)
	local attente = nil          -- debut de l'attente d'une caisse (FIND_CAISSE) : au-dela de DELAI_ABANDON, le client repart sans payer

	local state = "CAR_QUEUE"

	while car.Parent do
		local data = PlayerData.GetData(player)
		if not data then break end

		-- fin du cycle de la station (quel que soit l'etat : le PNJ peut encore etre a la caisse)
		if cycle and not lave and os.clock() >= cycle.fin then
			lave = true
			finirCycle(cycle, car)
		end

		-- =========================================================================
		-- ÉTAT 1 : AVANCEMENT DANS LA FILE D'ATTENTE GÉNÉRALE
		-- =========================================================================
		if state == "CAR_QUEUE" then
			-- Regles de la file :
			--   * les noeuds 1 (devant l'entree) et 2 (carrefour) sont un COULOIR DE PASSAGE : personne n'y attend. Les
			--     clients venus du tunnel attendent sur la branche a partir du noeud 3 ; les voitures achetees au centre
			--     attendent sur la route du tour avant le carrefour. On ne descend au noeud 2 / 1 que pour entrer.
			--   * une voiture achetee au centre est prioritaire : elle est inseree en tete de file.
			--   * si le plot n'a AUCUNE station utilisable (employe + stock), la voiture ne s'arrete pas : elle passe
			--     devant le plot et continue jusqu'au despawn (trajet de sortie).
			local newposition = table.find(session.Queue, carID)
			local nbNoeuds = #spawnFolder.QueueNodes:GetChildren()          -- autant de places dans la file que de noeuds

			if newposition then
				if not PlotPret(player, session, spawnFolder) then
					state = "PASSE"
				elseif achetee then
					-- place d'attente (position p -> place p sur la route du tour)
					if newposition ~= position then
						position = newposition
						local target = CarManager.PlaceAttenteAchat(spawnFolder, position)
						if target then AnimationNodeCar(car, target, true); task.wait(0.3) end
					end
					if position == 1 then state = "FIND_STATION" end
				else
					-- clients du tunnel : position p -> noeud p + 2 (le noeud 3 est la tete de file), jamais au-dela du dernier noeud
					local cible = math.min(newposition + 2, nbNoeuds)
					if position == 0 then position = nbNoeuds + 1 end
					while position > cible do
						position = position - 1
						local target = spawnFolder.QueueNodes:FindFirstChild(tostring(position))
						if target then
							local lastnode = (position == cible)
							AnimationNodeCar(car, target, lastnode)
							if lastnode then task.wait(0.3) end
						end
					end
					if newposition == 1 then state = "FIND_STATION" end
				end
			end

			-- =========================================================================
			-- ÉTAT 1 bis : LE PLOT NE PEUT PAS SERVIR -> LA VOITURE PASSE SON CHEMIN JUSQU'AU DESPAWN
			-- =========================================================================
		elseif state == "PASSE" then
			local idx = table.find(session.Queue, carID)
			if idx then table.remove(session.Queue, idx) end
			if not achetee then
				-- depuis la branche : descend la file jusqu'au carrefour puis devant l'entree
				if position == 0 then position = nbNoeudsDe(spawnFolder) + 1 end
				while position > 1 do
					position = position - 1
					local target = spawnFolder.QueueNodes:FindFirstChild(tostring(position))
					if target then AnimationNodeCar(car, target, position == 1) end
				end
			else
				local n1 = spawnFolder.QueueNodes:FindFirstChild("1")
				if n1 then AnimationNodeCar(car, n1, false) end
			end
			-- puis la route du tour : trajet de sortie a partir du noeud 2 (le 1 est dans le plot)
			local i = 2
			local target = spawnFolder.ExitNodes:FindFirstChild(tostring(i))
			while target do
				AnimationNodeCar(car, target, false)
				i = i + 1
				target = spawnFolder.ExitNodes:FindFirstChild(tostring(i))
			end
			car:Destroy()
			break

			-- =========================================================================
			-- ÉTAT 2 : RECHERCHE D'UNE STATION DISPONIBLE
			-- =========================================================================
		elseif state == "FIND_STATION" then
			
			-- toujours en tete de file ? (une voiture achetee au centre a pu s'inserer devant : elle passe d'abord)
			if table.find(session.Queue, carID) ~= 1 then
				state = "CAR_QUEUE"
				continue
			end
			stationID = FindStation(player, carID, session, spawnFolder)
			station = data.Stations and data.Stations[stationID]
			if station then
				local okRoute, cf, aller = StationDesservie(player, session, spawnFolder, station, stationID)
				if not okRoute then
					-- la route a change entre-temps : on reprend la file
					state = "CAR_QUEUE"
					continue
				end
				table.remove(session.Queue, 1)
				state = "WAITING_SERVICE"
				station.Car = carID
				station.Service = "Taken"

				-- conduite : on ralentit au carrefour (noeud 2 puis 1 pour les clients du tunnel ; noeud 1 seul pour une
				-- voiture venue de la route), on entre dans le plot doucement, on suit le couloir de goudron (points de
				-- virage, plus lent dans les virages), puis on se gare dans la voie de la station.
				local yPlot = Circulation.YPlot(spawnFolder, session.Pivot)
				if car:GetAttribute("Achetee") ~= true then
					local n2 = spawnFolder.QueueNodes:FindFirstChild("2")
					if n2 then AnimationNodeCar(car, n2, false, Circulation.VITESSE_APPROCHE) end
				end
				local n1 = spawnFolder.QueueNodes:FindFirstChild("1")
				if n1 then AnimationNodeCar(car, n1, false, Circulation.VITESSE_APPROCHE) end
				local entree = spawnFolder:FindFirstChild("Entree")
				if entree then AnimationNodeCar(car, entree, false, Circulation.VITESSE_PLOT) end
				local cfEntreeStation = Circulation.PointsStation(cf)
				local carte = Circulation.Carte(player)
				if carte and aller then
					for _, etape in ipairs(Circulation.Trajet(carte, session.Pivot, aller, yPlot, cfEntreeStation.LookVector)) do
						if not car.Parent then break end
						AnimationNodeCar(car, etape.cf, false, etape.vitesse)
					end
				end
				if car.Parent then AnimationNodeCar(car, cfEntreeStation, false, Circulation.VITESSE_STATION) end
				if car.Parent then AnimationNodeCar(car, cf, true, Circulation.VITESSE_STATION) end
				if car.Parent then car:PivotTo(cf) end
			end


			-- =========================================================================
			-- ÉTAT 4 : ATTENTE DES RESSOURCES / EMPLOYÉ À LA STATION
			-- =========================================================================
		elseif state == "WAITING_SERVICE" then
			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				break
			end

			if station.Quantity > 0 and station.Worker ~= nil then
				-- le service commence : la station s'anime avec cette voiture chez tous les joueurs,
				-- pendant ce temps le client (PNJ) va payer a la caisse
				cycle = lancerCycle(player, station, stationID, car)
				lave = false
				state = "FIND_CAISSE"
			end
	
			-- =========================================================================
			-- ÉTAT 5 : RECHERCHE D'UNE CAISSE ET DU CHEMIN ALLER
			-- =========================================================================
		elseif state == "FIND_CAISSE" then
			
			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				break
			end

			caisseID = FindCaisse(player)
			if caisseID and data.Caisses and data.Caisses[caisseID] then
				caisse = data.Caisses[caisseID]

				local infosMeuble = Catalogue.GetInfo("Furniture", station.Name)
				if infosMeuble and infosMeuble.Pivot == "centre" then
					startX, startZ = station.X, station.Z            -- pivot central : le PNJ part du milieu de la station
				elseif station.Orientation == 0 then
					startX, startZ = station.X + 1, station.Z - 1
				elseif station.Orientation == 1 then
					startX, startZ = station.X - 1, station.Z + 1
				elseif station.Orientation == 2 then
					startX, startZ = station.X - 1, station.Z + 1
				elseif station.Orientation == 3 then
					startX, startZ = station.X + 1, station.Z - 1	
				end

				if caisse.Orientation == 0 then
					cibleX, cibleZ = caisse.X - 1, caisse.Z
				elseif caisse.Orientation == 3 then
					cibleX, cibleZ = caisse.X, caisse.Z - 1
				elseif caisse.Orientation == 2 then
					cibleX, cibleZ = caisse.X + 1, caisse.Z 
				elseif caisse.Orientation == 1 then
					cibleX, cibleZ = caisse.X, caisse.Z + 1	
				end 

				local succes, chemin = CheminPNJ(player, startX, startZ, cibleX, cibleZ)
				if succes then
					if PlayerData.JoinQueue(player, caisseID, carID) then
						
						-- le client descend de sa voiture et marche jusqu'a la caisse (1 case de large, sans mur ni meuble)
						pnj = SpawnPNJ(player, chemin, car)
						AnimationPNJ(player, pnj, chemin)
						QueuePNJ(player,pnj,caisse,carID)
						
						last = 0
						attente = nil
						state = "QUEUE_CAISSE"
					end
				end
			end
			-- aucune caisse (ou aucun chemin a pied) pendant DELAI_ABANDON : le client repart SANS PAYER avec sa voiture,
			-- la station est liberee (sinon elle resterait bloquee pour toujours)
			attente = attente or os.clock()
			if state == "FIND_CAISSE" and os.clock() - attente > DELAI_ABANDON then
				alerter(player, "Un client est reparti sans payer : aucune caisse accessible a pied depuis la station (place une caisse et un chemin de 1 case de large)")
				attente = nil
				state = "ABANDON"
			end

			-- =========================================================================
			-- ÉTAT 6 : ATTENTE DANS LA FILE DE LA CAISSE ET PAIEMENT
			-- =========================================================================
		elseif state == "QUEUE_CAISSE" then

			station = data.Stations and data.Stations[stationID]
			if not station then
				PlayerData.AddToRecoveryQueue(player, car:GetAttribute("Name"), car:GetAttribute("Tier"))
				car:Destroy()
				PlayerData.LeaveQueue(player, caisseID, carID)
				pnj:Destroy()
				break
			end
			
			if not data.Caisses or not data.Caisses[caisseID] then
				pnj:Destroy()
				caisseID = nil
				caisse = nil
				state = "FIND_CAISSE"
				continue
			end

			caisse = data.Caisses[caisseID]
			local place = table.find(caisse.Queue, carID)

			if place and place ~= last then
				last = place
				QueuePNJ(player,pnj,caisse,carID)
			end

			if place == 1 and caisse.Worker ~= nil then
				
				task.wait(3)
				station = data.Stations and data.Stations[stationID]

				if station then
					-- le client a paye : il RETOURNE A SA VOITURE (meme regle de passage : 1 case de large, sans mur ni
					-- meuble), monte dedans, et c'est la voiture qui repart par le couloir de goudron (etats COMPLETED ->
					-- WAIT_EXIT -> EXIT). Le client ne quitte jamais le plot a pied.
					local succes, chemin = CheminPNJ(player, cibleX, cibleZ, startX, startZ)
					PlayerData.LeaveQueue(player, caisseID, carID)
					if succes then
						AnimationPNJ(player, pnj, chemin, car)
					else
						-- plus aucun sol entre la caisse et la station : on le ramene directement a la portiere
						alerter(player, "Un client ne trouve plus de chemin pour retourner a sa voiture : il y est ramene directement")
						AnimationPNJ(player, pnj, {}, car)
					end
					pnj:Destroy()
					pnj = nil
					state = "COMPLETED"
				end
			end
 
			-- =========================================================================
			-- ÉTAT 7 : FINALISATION DU SERVICE ET NETTOYAGE
		elseif state == "COMPLETED" then
			-- le paiement est encaisse quand le lavage / le service est termine (on attend la fin du cycle)
			if lave then
				station = data.Stations and data.Stations[stationID]
				if station then

					local infos = Catalogue.GetInfo("Consommable", station.Item)

					local Name = car:GetAttribute("Name")
					local Tier =  car:GetAttribute("Tier")

					if infos and Car[Tier] then
						-- mutation (script Mutations) : une voiture en or paie x3, en argent x2, electrique x1,5
						local mutation = car:GetAttribute("Mutation")
						local bonus = (mutation == "Or" and 3) or (mutation == "Argent" and 2) or (mutation == "Electrique" and 1.5) or 1
						PlayerData.AddMoney(player, math.floor((infos.Buy +  (infos.Sell - infos.Buy) * Car[Tier].Mult * (station.Mult or 1)) * bonus + 0.5))
						PlayerData.AddXp(player,50* Car[Tier].Mult)
						PlayerData.RemoveItemStation(player, stationID)
						PlayerData.AddCar(player, Name, Tier)
					end
				end

				state = "WAIT_EXIT"
			end
		
			-- =========================================================================
			-- ÉTAT 7 bis : CLIENT PARTI SANS PAYER (aucune caisse accessible) -> la voiture repart quand le cycle est fini
			-- =========================================================================
		elseif state == "ABANDON" then
			if lave then
				if pnj then pnj:Destroy(); pnj = nil end
				state = "WAIT_EXIT"
			end

			-- =========================================================================
			-- ÉTAT 8 : ATTENTE QUE LE NODE 1 DE SORTIE SOIT LIBRE
			-- =========================================================================
		elseif state == "WAIT_EXIT" then
			if not session.Exit then
				session.Exit = carID

				station = data.Stations and data.Stations[stationID]
				if station then
					station.Car = nil
					station.Service = "Available"
				end

				-- la voiture redemarre doucement, sort de la voie de la station, suit le couloir de goudron jusqu'a la
				-- sortie du plot (ExitNodes/1), puis reaccelere sur la route (etat EXIT)
				local premier = spawnFolder.ExitNodes:FindFirstChild("1")
				local carte = Circulation.Carte(player)
				local _, cfSortieStation = Circulation.PointsStation(car:GetPivot())
				AnimationNodeCar(car, cfSortieStation, false, Circulation.VITESSE_STATION)
				if carte and premier then
					local yPlot = Circulation.YPlot(spawnFolder, session.Pivot)
					local qbx, qbz = Circulation.BlocDe(carte, session.Pivot, cfSortieStation.Position)
					local _, _, sbx, sbz = Circulation.BlocsAcces(carte, session.Pivot, spawnFolder)
					local retour = sbx and Circulation.Chemin(carte, qbx, qbz, sbx, sbz)
					if retour then
						for _, etape in ipairs(Circulation.Trajet(carte, session.Pivot, retour, yPlot, premier.CFrame.LookVector)) do
							if not car.Parent then break end
							AnimationNodeCar(car, etape.cf, false, etape.vitesse)
						end
					else
						warn("[Cars] sortie de station sans couloir de goudron vers la sortie du plot : la voiture sort en ligne droite")
					end
				end
				if premier and car.Parent then AnimationNodeCar(car, premier, false, Circulation.VITESSE_PLOT) end
				state = "EXIT"
			end

			-- =========================================================================
			-- ÉTAT 9 : SORTIE PAR LES NODES
			-- =========================================================================
		elseif state == "EXIT" then
			local i = 2
			local target = spawnFolder.ExitNodes:FindFirstChild(tostring(i))

			while target do
				AnimationNodeCar(car, target, false, (i == 2) and Circulation.VITESSE_APPROCHE or nil)

				if session.Exit == carID then
					session.Exit = nil
				end

				i = i + 1
				target = spawnFolder.ExitNodes:FindFirstChild(tostring(i))
			end

			car:Destroy()
			break
		end

		task.wait(1)
	end

	-- la voiture a disparu en plein cycle (station detruite, joueur parti...) : la station ne doit pas rester "en service"
	if cycle and not lave then finirCycle(cycle, car) end
end

-- ======================================================================================================================
-- GESTION DU GENERATEUR
-- ======================================================================================================================

-- utilises aussi par les voitures d'ambiance (CarAmbiance)
CarManager.SpawnCar = SpawnCar
CarManager.AnimationNodeCar = AnimationNodeCar

-- ======================================================================================================================
-- VOITURES ACHETEES AU CENTRE (CarAmbiance) : elles deviennent des clientes du plot de l'acheteur
-- ======================================================================================================================
local ESPACE_ATTENTE = 22          -- studs entre deux voitures qui attendent sur la route du tour
local RECUL_ATTENTE = 65           -- de l'entree (noeud 1) au carrefour de la branche (35) + demi-route et marge (30)

-- place d'attente k (1 = la plus proche) sur la route du tour, avant le carrefour, dans le sens de la file (noeud 1)
function CarManager.PlaceAttenteAchat(spawnFolder, k)
	local n1 = spawnFolder:FindFirstChild("QueueNodes") and spawnFolder.QueueNodes:FindFirstChild("1")
	if not n1 then return nil end
	local cf = n1.CFrame
	return cf - cf.LookVector * (RECUL_ATTENTE + ESPACE_ATTENTE * (k - 1))
end

-- point ou la voiture achetee doit arriver (derniere place d'attente possible = fin du trajet depuis le centre)
function CarManager.ArriveeAchat(player)
	local session = Sessions[player.UserId]
	if not session or not session.SpawnFolder then return nil end
	local n = 1
	for _, id in ipairs(session.Queue) do
		local autre = session.Dossier:FindFirstChild(id)
		if autre and autre:GetAttribute("Achetee") == true then n += 1 end
	end
	return CarManager.PlaceAttenteAchat(session.SpawnFolder, n)
end

function CarManager.PlotDe(player)
	local session = Sessions[player.UserId]
	return session and session.SpawnFolder or nil, session
end

-- la voiture (deja marquee Achetee, Tier, Name) rejoint la file du plot de l'acheteur
function CarManager.AccueillirVoitureAchetee(player, car)
	local session = Sessions[player.UserId]
	if not session or not session.Dossier.Parent then return false end
	car.Name = HttpService:GenerateGUID(false)
	car.Parent = session.Dossier
	task.spawn(function() CarLifecycle(car, player, session.SpawnFolder) end)
	return true
end

function CarManager.Start(player: Player, spawnfolder: Folder) 

	if Sessions[player.UserId] then return end

	local folder = workspace.Plots:FindFirstChild(player.Name .. "'s plot")
	if not folder then return end

	local dossier = Instance.new("Folder")
	dossier.Name = "Cars_" .. player.UserId
	dossier.Parent = workspace

	Sessions[player.UserId] = {
		Dossier = dossier,
		Queue = {},
		Pivot = folder.PlotCenterRef.Value:GetPivot(),
		Exit = nil,
		SpawnFolder = spawnfolder,
	}

	local tunnel = spawnfolder:FindFirstChild("Tunnel")

	task.spawn(function()
		while dossier.Parent do
			task.wait(math.random(CADENCE_MIN, CADENCE_MAX))

			if not dossier.Parent then break end

			local carID = HttpService:GenerateGUID(false)
			local carName, carTier = PlayerData.GetFromRecoveryQueue(player)
			if not carName or not carTier then
				carName, carTier = PickRandomCar(player)
			end

			local carTemplate = Car.Modele(carTier, carName)
			if not carTemplate then warn("[Cars] modele introuvable : " .. tostring(carTier) .. "/" .. tostring(carName)) continue end

			local car = SpawnCar(carTemplate)

			car.Name = carID
			car:SetAttribute("Tier", carTier)
			car:SetAttribute("Name", carName)
			car.Parent = dossier
			car:PivotTo(tunnel:GetPivot())

			task.wait(0.3)

			task.spawn(function()
				CarLifecycle(car, player, spawnfolder)
			end)
		end
	end)
end

function CarManager.Stop(player: Player)
	local session = Sessions[player.UserId]
	if session then
		session.Dossier:Destroy()
	end

	Sessions[player.UserId] = nil
end

return CarManager