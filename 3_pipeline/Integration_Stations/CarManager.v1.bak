local CarManager = {}
local PlayerData = require(game:GetService("ServerScriptService"):WaitForChild("PlayerData"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalogue = require(ReplicatedStorage:WaitForChild("Catalogue"))
local HttpService = game:GetService("HttpService")

local Sessions = {}

local Car = require(ReplicatedStorage:WaitForChild("Catalogue"):WaitForChild("Car"))

local MovePnjEvent = ReplicatedStorage:WaitForChild("MovePnjEvent")
local MoveCarEvent = ReplicatedStorage:WaitForChild("MoveCarEvent")

-- ======================================================================================================================
-- STATIONS ANIMEES (ReplicatedStorage > Stations)
--   Le serveur ne calcule aucun mouvement : il pose sur le modele 3D de la station l'attribut "CycleDebut" (heure
--   serveur du debut du service) et un ObjectValue "VoitureCycle" (la voiture cliente). Chez chaque joueur, le module
--   Stations > Client cache cette voiture, anime une copie soudee a la station, puis la re-affiche quand CycleDebut
--   revient a 0. Le serveur attend simplement la duree du cycle (CYCLE, donnees de la station) : ce sont ces donnees,
--   et jamais le client, qui font foi pour l'economie (stock consomme, paiement, XP).
-- ======================================================================================================================

local StationsDossier = ReplicatedStorage:FindFirstChild("Stations")
local Y_LOIN = 36        -- distance (studs, repere du modele) d'ou arrive / ou repart la voiture dans les animations

-- donnees d'une station (module ReplicatedStorage > Stations > Donnees > <nom du meuble>), nil si le meuble n'en a pas
local function donneesStation(nomStation)
	local dossier = StationsDossier and StationsDossier:FindFirstChild("Donnees")
	local mod = dossier and dossier:FindFirstChild(nomStation)
	if not mod then return nil end
	local ok, D = pcall(require, mod)
	return ok and type(D) == "table" and D or nil
end

-- modele 3D d'un meuble du plot (attribut FurnitureID pose par PlotManager)
local function trouverMeuble(player, furnitureID)
	local folder = workspace.Plots:FindFirstChild(player.Name .. "'s plot")
	if not folder then return nil end
	for _, objet in ipairs(folder:GetChildren()) do
		if objet:GetAttribute("FurnitureID") == furnitureID then return objet end
	end
	return nil
end

-- position de la voiture dans la voie de la station : y = position le long de la voie (repere du modele ;
-- nil = place de stationnement, -Y_LOIN = point de sortie). Le Socle de la station porte le repere du modele.
local function pointStation(meuble, D, y)
	local socle = meuble and meuble:FindFirstChild("Socle")
	if not (socle and D) then return nil end
	local parc = D.PARC or (D.SEGMENTS and D.SEGMENTS[1] and D.SEGMENTS[1].parc)
	if not parc then return nil end
	local pos = socle.CFrame * Vector3.new(parc[1], y or parc[2], parc[3])
	local dir = socle.CFrame:VectorToWorldSpace(Vector3.new(0, -1, 0))     -- la voiture regarde vers -Y du modele
	return CFrame.lookAt(pos, pos + dir)
end

-- lance le cycle de la station chez les joueurs ; renvoie {meuble, D, fin} (fin = os.clock() de fin de service)
local function lancerCycle(player, station, stationID, car)
	local meuble = trouverMeuble(player, stationID)
	local D = meuble and donneesStation(station.Name)
	if not (meuble and D and meuble:FindFirstChild("Socle")) then
		return {fin = os.clock() + 5}                                       -- meuble sans animation : service symbolique
	end
	local ov = meuble:FindFirstChild("VoitureCycle")
	if not ov then ov = Instance.new("ObjectValue"); ov.Name = "VoitureCycle"; ov.Parent = meuble end
	ov.Value = car
	meuble:SetAttribute("CycleDebut", workspace:GetServerTimeNow())
	return {meuble = meuble, D = D, fin = os.clock() + (D.CYCLE or 20)}
end

-- fin du cycle : la voiture reelle est posee au point de sortie de la station, le client la re-affiche
local function finirCycle(cycle, car)
	local meuble = cycle.meuble
	if meuble and meuble.Parent then
		local cf = pointStation(meuble, cycle.D, -Y_LOIN)
		if cf and car.Parent then car:PivotTo(cf) end
		meuble:SetAttribute("CycleDebut", 0)
		local ov = meuble:FindFirstChild("VoitureCycle")
		if ov then ov.Value = nil end
	end
end

-- ======================================================================================================================
-- PROVISOIRES
-- ======================================================================================================================

local function PickRandomCar(player: Player)

	local rank, probas  = PlayerData.GetRank(player)

	local rand = math.random()
	local cumulative = 0
	local tier = 1

	for i, chance in ipairs(probas) do
		cumulative = cumulative + chance
		if rand <= cumulative then
			tier = i
			break
		end
	end

	local nomTier = Car.Ordre[tier]
	local pool = Car[nomTier]
	return pool.Models[math.random(1, #pool.Models)], nomTier
end

-- ======================================================================================================================
-- STATIONS
-- ======================================================================================================================

local LONGUEUR_VOITURE = 16      -- longueur des voitures clientes (studs) : celle des animations des stations

local function SpawnCar(carTemplate)

	local car = carTemplate:Clone()

	-- mise a l'echelle : les modeles sources font ~29 studs, les stations sont animees pour 16
	local ext = car:GetExtentsSize()
	local L = math.max(ext.X, ext.Z)
	if L > 0 and math.abs(L - LONGUEUR_VOITURE) > 0.3 then
		car:ScaleTo(car:GetScale() * LONGUEUR_VOITURE / L)
	end

	local centre, taille = car:GetBoundingBox()

	local racine = Instance.new("Part")
	racine.Name = "Root"
	racine.Size = Vector3.new(1, 1, 1)
	racine.Transparency = 1
	racine.CanCollide = false
	racine.CanQuery = false
	racine.CanTouch = false
	racine.Anchored = true
	racine.CFrame = centre * CFrame.new(0, -taille.Y / 2, 0)
	racine.Parent = car

	for _, piece in ipairs(car:GetDescendants()) do
		if piece:IsA("BasePart") and piece ~= racine then
			piece.CanCollide = false
			piece.CanQuery = false
			piece.CanTouch = false
			piece.Anchored = false

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = racine
			weld.Part1 = piece
			weld.Parent = racine
		end
	end

	car.PrimaryPart = racine
	-- la voiture arrive entiere chez les joueurs (StreamingEnabled) : le client des stations la mesure et la copie
	pcall(function() car.ModelStreamingMode = Enum.ModelStreamingMode.Atomic end)

	return car
end

local function AnimationNodeCar(car, target, last)
	local root = car.PrimaryPart
	if not root then return end

	local startCFrame = root.CFrame
	local targetCFrame = target.CFrame

	local duree = 0
	local p0 = startCFrame.Position
	local p2 = targetCFrame.Position
	local k = (p2 - p0).Magnitude * 0.39
	local controle1 = p0 + startCFrame.LookVector * k
	local controle2 = p2 - targetCFrame.LookVector * k

	local distance = 0
	local precedent = p0
	for i = 1, 20 do
		local t = i / 20
		local u = 1 - t
		local point = u^3 * p0 + 3 * u^2 * t * controle1 + 3 * u * t^2 * controle2 + t^3 * p2
		distance = distance + (point - precedent).Magnitude
		precedent = point
	end
	duree = distance / 45

	local etatanimation = 0
	if last then
		etatanimation = 2 
	end

	MoveCarEvent:FireAllClients(car, targetCFrame, duree, etatanimation)

	task.wait(duree)

	car:PivotTo(targetCFrame)
end

local function FindStation(player, carID)
	
	local data = PlayerData.GetData(player)
	if not data or not data.Stations then 
		return nil 
	end

	for furnitureID, station in pairs(data.Stations) do

		if station.Service == "Available" then
			return furnitureID
		end
	end

	return nil
end

